# ============================================================
# Vite environment variables for TOEFL Allmyexam
# 이 파일을 복사해 .env.local 을 만들고 실제 값을 채우세요.
# .env.local 은 .gitignore 에 등록되어 커밋되지 않습니다.
# ============================================================

# Optional: Override the Supabase Functions origin.
# Defaults to https://<PROJECT_ID>.supabase.co/functions/v1
# Set this when using a custom domain or a different deployment.
# VITE_SERVER_ORIGIN=https://xmdfbjfmiavuxlpzawan.supabase.co/functions/v1

# Optional: Override the edge-function path prefix.
# Defaults to /make-server-e46cd33a
# VITE_SERVER_BASE_PATH=/make-server-e46cd33a

# ──────────────────────────────────────────────────────────────────────────
#  AI API 키 (보안)
#  ──────────────────────────────────────────────────────────────────────────
#  두 개의 AI 모델을 사용합니다 — 둘 다 Vercel 서버리스 프록시 경유 (서버 env 키):
#    • GLM (open.bigmodel.cn) → /api/glm/chat/completions       — 빠른 응답용
#    • Claude (apiclaude.cc)  → /api/claude/chat/completions    — 고품질 응답용
#
#  ⚠️ 보안:
#    - 두 키 모두 서버 환경변수(GLM_API_KEY / CLAUDE_API_KEY)로만 관리.
#    - 클라이언트 번들에 노출되지 않음 → GitHub 노출/도용 방지.
#    - .env.local 은 절대 커밋하지 마세요 (.gitignore 에 포함).
# ──────────────────────────────────────────────────────────────────────────

# ── GLM AI 모델 (프로덕션 — Vercel 환경변수) ──────────────────────────────
# ⚠️ Vercel Project Settings → Environment Variables 에서 등록:
#    변수명: GLM_API_KEY
#    값:     open.bigmodel.cn 에서 발급받은 실제 키 (형식: xxxx.xxxx)
#    api/glm/chat/completions.ts 서버리스 함수가 이 키로 GLM 호출.
#
# 로컬 개발 시 .env.local 에도 GLM_API_KEY 를 넣으면 vite dev 프록시가 사용.
# GLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx

# 레거시 fallback (기존 배포에서 VITE_GLM_API_KEY 로만 등록된 경우도 서버가 인식):
# VITE_GLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx

# ── Claude AI 튜터 (개발 환경) ─────────────────────────────────────────────
# vite dev server proxy 가 apiclaude.cc 호출 시 사용할 API 키.
# VITE_DEV_CLAUDE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Claude AI 튜터 (프로덕션 — Vercel 환경변수) ───────────────────────────
# ⚠️ Vercel 대시보드에서 CLAUDE_API_KEY 설정 필수.

# ── Electron 환경 프록시 URL ──────────────────────────────────────────────
# Electron 은 상대 경로가 작동하지 않으므로 절대 URL 필요. 미설정 시 기본값 사용.
# VITE_CLAUDE_PROXY_URL=https://your-app.vercel.app/api/claude/chat/completions
# VITE_GLM_PROXY_URL=https://your-app.vercel.app/api/glm/chat/completions

# ──────────────────────────────────────────────────────────────────────────
#  STT (Speech-to-Text) — 2026 Speaking AI 채점 파이프라인
#  ──────────────────────────────────────────────────────────────────────────
#  Speaking 채점(Listen & Repeat / Take an Interview)은 녹음 → STT → WER/LLM 채점
#  순서로 진행됩니다. STT 엔진 폴백 체인 (useStt.ts):
#
#    1순위) Deepgram Nova-3 (클라우드, 200~300ms, 단어 타임스탬프, $200 무료 크레딧)
#           → POST /api/stt/deepgram  (DEEPGRAM_API_KEY 필요)
#    2순위) 로컬 Whisper (오프라인, 무료, Transformers.js) — dev 전용
#           → POST http://localhost:8787/transcribe  (npm run whisper:local)
#    3순위) Web Speech API (브라우저 내장, 빈 결과 폴백)
#
#  ── Deepgram API 키 (1순위 — 프로덕션 권장) ───────────────────────────────
#  Deepgram 콘솔(https://console.deepgram.com/)에서 발급. 신규 가입 시 $200 크레딧.
#  ⚠️ 이 변수는 Vercel 대시보드 환경변수로 등록 (서버 전용, 클라이언트 노출 안 됨).
#    변수명: DEEPGRAM_API_KEY
#    로컬 개발: .env.local 의 DEEPGRAM_API_KEY (vite dev proxy 경유, 서버리스 함수가 읽음)
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
#
#  ── 로컬 Whisper dev 서버 (2순위 폴백 — 오프라인/무료) ─────────────────────
#  npm run whisper:local 로 로컬 Whisper 서버 실행 (Transformers.js, 포트 8787).
#  DEEPGRAM_API_KEY 미설정 또는 실패 시 useStt.ts 가 자동 폴백.
#  사전 요구사항: @xenova/transformers 패키지 (npm install 로 자동 설치됨).
#    ffmpeg 불필요 — 브라우저에서 Web Audio API 로 webm/mp4 → WAV(16kHz mono)
#    변환 후 전송하여 로컬 서버가 ffmpeg 없이도 디코딩 가능.
#  시스템 프록시 자동 감지(Windows): scripts/local-whisper-server.cjs 가 Windows
#    레지스트리에서 시스템 프록시를 읽어 HuggingFace 모델 다운로드에 적용.
#    (HTTP_PROXY/HTTPS_PROXY env var 가 이미 설정되어 있으면 그것을 존중.)
#  (옵션) 로컬 Whisper 서버 URL 오버라이드 (기본값: http://localhost:8787/transcribe)
# VITE_LOCAL_WHISPER_URL=http://localhost:8787/transcribe
#  (옵션) Whisper 모델 변경 (기본값: Xenova/whisper-base.en)
#    옵션: Xenova/whisper-tiny.en (빠름/저정확), Xenova/whisper-large-v3 (느림/고정확)
#  → scripts/local-whisper-server.cjs 실행 시 WHISPER_MODEL 환경변수로 전달
#
#  ⚠️ Electron 환경에서 STT 프록시 URL:
#    useStt.ts 는 VITE_CLAUDE_PROXY_URL 에서 '/api/claude/...' → '/api/stt/deepgram'
#    로 자동 치환합니다. 위 VITE_CLAUDE_PROXY_URL 만 설정하면 Deepgram STT 도 동작.
#
#  ⚠️ Vercel 라우팅 주의:
#    vercel.json 의 catch-all rewrite({ "/(.*)": "/" })는 /api/* 함수보다
#    우선순위가 낮으므로 /api/stt/deepgram 서버리스 함수는 정상 서비스됨.
#
#  ── 레거시: apiclaude.cc Whisper (더 이상 사용 안 함) ──────────────────────
#  api/stt/transcriptions.ts (apiclaude.cc /v1/audio/transcriptions)는
#  404 응답으로 확인되어 더 이상 폴백 체인에 포함되지 않습니다.
#  Deepgram(1순위) + 로컬 Whisper(2순위)로 대체되었습니다.

